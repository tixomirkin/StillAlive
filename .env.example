# =============================================
# StillAlive — Environment Configuration
# =============================================
# Copy this file to .env and fill in the values

# ── General ──────────────────────────────────
NODE_ENV=development

# ── Database (PostgreSQL) ────────────────────
DATABASE_URL=postgresql://stillalive:stillalive_secret@localhost:5432/stillalive?schema=public
DATABASE_USER=stillalive
DATABASE_PASSWORD=stillalive_secret
DATABASE_NAME=stillalive
DATABASE_PORT=5432

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ── NATS ─────────────────────────────────────
NATS_URL=nats://localhost:4222

# ── JWT ──────────────────────────────────────
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── API Gateway ──────────────────────────────
API_GATEWAY_PORT=3000

# ── Monitor Service ──────────────────────────
MONITOR_SERVICE_PORT=3001

# ── Analytics Service ────────────────────────
ANALYTICS_SERVICE_PORT=3002

# ── Notification Service ─────────────────────
NOTIFICATION_SERVICE_PORT=3003

# ── Checker Worker (Go) ─────────────────────
CHECKER_WORKER_CONCURRENCY=10
CHECKER_WORKER_TIMEOUT=30s

# ── Email (SMTP) ─────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@stillalive.dev

# ── Slack ────────────────────────────────────
SLACK_WEBHOOK_URL=
