generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  name               String
  passwordHash       String?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  monitors           Monitor[]
  notificationConfigs NotificationConfig[]
}

enum MonitorType {
  HTTP
  TCP
  PING
  KEYWORD
}

enum MonitorStatus {
  UP
  DOWN
  PENDING
  PAUSED
}

model Monitor {
  id                 String               @id @default(uuid())
  userId             String
  name               String
  type               MonitorType
  url                String
  interval           Int                  @default(300)
  timeout            Int                  @default(30)
  httpMethod         String?
  expectedStatusCode Int?
  keyword            String?
  headers            Json?
  body               String?
  status             MonitorStatus        @default(PENDING)
  lastCheckedAt      DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User                 @relation(fields: [userId], references: [id])
  checkResults       CheckResult[]
  monitorNotifications MonitorNotification[]
  incidents          Incident[]
}

model CheckResult {
  id           String        @id @default(uuid())
  monitorId    String
  status       MonitorStatus
  statusCode   Int?
  responseTime Float
  error        String?
  region       String?
  checkedAt    DateTime      @default(now())
  monitor      Monitor       @relation(fields: [monitorId], references: [id])

  @@index([monitorId, checkedAt])
}

enum NotificationChannel {
  EMAIL
  SLACK
  DISCORD
  WEBHOOK
  TELEGRAM
}

model NotificationConfig {
  id                   String                @id @default(uuid())
  userId               String
  channel              NotificationChannel
  name                 String
  config               Json
  isEnabled            Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  user                 User                  @relation(fields: [userId], references: [id])
  monitorNotifications MonitorNotification[]
}

model MonitorNotification {
  monitorId            String
  notificationConfigId String
  monitor              Monitor            @relation(fields: [monitorId], references: [id])
  notificationConfig   NotificationConfig @relation(fields: [notificationConfigId], references: [id])

  @@id([monitorId, notificationConfigId])
}

model Incident {
  id        String    @id @default(uuid())
  monitorId String
  startedAt DateTime  @default(now())
  resolvedAt DateTime?
  cause     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  monitor   Monitor   @relation(fields: [monitorId], references: [id])
}
